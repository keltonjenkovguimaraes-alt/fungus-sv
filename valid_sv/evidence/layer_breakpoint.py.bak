#!/usr/bin/env python3
"""
Evidence Layer: Breakpoint Junction Analysis
==============================================
Analyzes split reads and soft-clipped reads at SV breakpoints
to confirm precise breakpoint locations.

For PacBio HiFi reads: Looks for reads with SA (supplementary alignment)
tags or soft-clipping at SV boundaries. Confirms that breakpoints
are supported by reads spanning the junction.

Author: VALID-SV / FUNGUS-SV
"""

import subprocess
import re
from dataclasses import dataclass
from enum import Enum
from typing import Optional


class BreakpointVerdict(Enum):
    CONFIRMED = "confirmed"
    PARTIAL = "partial_support"
    WEAK = "weak_support"
    INSUFFICIENT_DATA = "insufficient_data"
    NO_SUPPORT = "no_support"


@dataclass
class BreakpointEvidence:
    sv_id: str
    sv_type: str
    verdict: BreakpointVerdict
    evidence_score: float
    total_reads_at_breakpoint: int
    split_reads: int
    soft_clipped: int
    spanning_pairs: int
    details: str


def analyze_breakpoint_junctions(bam_path: str, sv_id: str, sv_type: str,
                                  chrom: str, start: int, end: int,
                                  window: int = 500) -> BreakpointEvidence:
    """
    Analyze breakpoint support using samtools to extract reads
    near SV boundaries and check for split/soft-clipped alignments.

    For PacBio HiFi: primary signal is SA tag (chimeric alignments)
    and soft-clipping at breakpoints.
    """
    
    # Extract reads near start breakpoint
    start_region = f"{chrom}:{max(0, start - window)}-{start + window}"
    end_region = f"{chrom}:{max(0, end - window)}-{end + window}"
    
    total_reads = 0
    split_reads = 0
    soft_clipped = 0
    
    try:
        # Get reads at start breakpoint
        result = subprocess.run([
            'samtools', 'view', bam_path, start_region
        ], capture_output=True, text=True, timeout=60)
        
        start_lines = result.stdout.strip().split('\n') if result.stdout.strip() else []
        
        # Get reads at end breakpoint
        result = subprocess.run([
            'samtools', 'view', bam_path, end_region
        ], capture_output=True, text=True, timeout=60)
        
        end_lines = result.stdout.strip().split('\n') if result.stdout.strip() else []
        
        all_lines = start_lines + end_lines
        total_reads = len(all_lines)
        
        for line in all_lines:
            if not line or line.startswith('@'):
                continue
            
            parts = line.split('\t')
            if len(parts) < 12:
                continue
            
            cigar = parts[5]
            flags = int(parts[1])
            
            # Check for SA tag (chimeric/supplementary alignment)
            sa_tag = None
            for tag in parts[11:]:
                if tag.startswith('SA:Z:'):
                    sa_tag = tag
                    break
            
            if sa_tag:
                split_reads += 1
            
            # Check for soft-clipping (CIGAR has S at start or end)
            if re.search(r'^\d+S', cigar) or re.search(r'\d+S$', cigar):
                soft_clipped += 1
        
        # Determine verdict based on available evidence
        if total_reads == 0:
            return BreakpointEvidence(
                sv_id=sv_id, sv_type=sv_type,
                verdict=BreakpointVerdict.INSUFFICIENT_DATA,
                evidence_score=0.0,
                total_reads_at_breakpoint=0,
                split_reads=0, soft_clipped=0, spanning_pairs=0,
                details=f"No reads found at breakpoints ({start_region}, {end_region})"
            )
        
        # Score based on proportion of reads supporting breakpoint
        supporting = split_reads + soft_clipped
        support_ratio = supporting / total_reads if total_reads > 0 else 0
        
        if support_ratio >= 0.10:
            verdict = BreakpointVerdict.CONFIRMED
            score = min(1.0, 0.5 + support_ratio * 5)
        elif support_ratio >= 0.05:
            verdict = BreakpointVerdict.PARTIAL
            score = 0.4 + support_ratio * 4
        elif support_ratio >= 0.02:
            verdict = BreakpointVerdict.WEAK
            score = 0.2 + support_ratio * 4
        elif supporting > 0:
            verdict = BreakpointVerdict.WEAK
            score = 0.1
        else:
            verdict = BreakpointVerdict.NO_SUPPORT
            score = 0.0
        
        details = (f"Start: {len(start_lines)} reads, End: {len(end_lines)} reads | "
                  f"Split: {split_reads}, Soft-clipped: {soft_clipped}, "
                  f"Support ratio: {support_ratio:.3f}")
        
        return BreakpointEvidence(
            sv_id=sv_id, sv_type=sv_type,
            verdict=verdict,
            evidence_score=round(score, 4),
            total_reads_at_breakpoint=total_reads,
            split_reads=split_reads,
            soft_clipped=soft_clipped,
            spanning_pairs=0,
            details=details
        )
        
    except subprocess.TimeoutExpired:
        return BreakpointEvidence(
            sv_id=sv_id, sv_type=sv_type,
            verdict=BreakpointVerdict.INSUFFICIENT_DATA,
            evidence_score=0.0,
            total_reads_at_breakpoint=0,
            split_reads=0, soft_clipped=0, spanning_pairs=0,
            details="Timeout while querying BAM"
        )
    except Exception as e:
        return BreakpointEvidence(
            sv_id=sv_id, sv_type=sv_type,
            verdict=BreakpointVerdict.INSUFFICIENT_DATA,
            evidence_score=0.0,
            total_reads_at_breakpoint=0,
            split_reads=0, soft_clipped=0, spanning_pairs=0,
            details=f"Error: {str(e)}"
        )


if __name__ == '__main__':
    import sys
    if len(sys.argv) < 7:
        print("Usage: layer_breakpoint.py <bam> <sv_id> <sv_type> <chrom> <start> <end>")
        print("Example: layer_breakpoint.py sample.bam SV_001 DEL chr1 50000 60000")
        sys.exit(1)
    
    result = analyze_breakpoint_junctions(
        sys.argv[1], sys.argv[2], sys.argv[3],
        sys.argv[4], int(sys.argv[5]), int(sys.argv[6])
    )
    
    print(f"\n{'='*60}")
    print(f"  Breakpoint Junction Analysis: {result.sv_id}")
    print(f"{'='*60}")
    print(f"  Total reads at breakpoints: {result.total_reads_at_breakpoint}")
    print(f"  Split reads: {result.split_reads}")
    print(f"  Soft-clipped: {result.soft_clipped}")
    print(f"  Verdict: {result.verdict.value}")
    print(f"  Score: {result.evidence_score:.3f}")
    print(f"  {result.details}")
    print(f"{'='*60}\n")
