"""
FUNGUS-SV: Structural variant discovery and triangulation-based
prioritization for non-model haploid fungi using PacBio HiFi reads.

Multi-environment architecture: Each rule runs in its own conda environment.
Environments defined in workflow/envs/*.yaml
"""

configfile: "config/config.yaml"

SAMPLES = config["samples"]


rule all:
    """Generate all outputs."""
    input:
        expand("results/alignment/{sample}.sorted.bam.bai", sample=SAMPLES),
        expand("results/variants/consensus/{sample}.consensus_svs.vcf", sample=SAMPLES),
        expand("results/validation/{sample}/validation_summary.txt", sample=SAMPLES),
        expand("results/validation/{sample}/validation_results.json", sample=SAMPLES),


rule minimap2_align:
    """Align PacBio HiFi reads to reference genome."""
    input:
        fq = "data/raw/{sample}.fastq.gz",
        ref = "data/reference/reference.mmi"
    output:
        bam = "results/alignment/{sample}.sorted.bam",
        bai = "results/alignment/{sample}.sorted.bam.bai"
    conda: "/home/kelto/miniforge3/envs/sv_align"
    threads: 8
    shell:
        """
        minimap2 -t {threads} -ax map-hifi {input.ref} {input.fq} \
        | samtools sort -@ 4 -o {output.bam} - \
        && samtools index {output.bam}
        """


rule icb_consensus:
    """Phase 1: Multi-caller consensus SV detection (ICB)."""
    input:
        bam = "results/alignment/{sample}.sorted.bam",
        ref = "data/reference/reference.fasta"
    output:
        consensus = "results/variants/consensus/{sample}.consensus_svs.vcf"
    conda: "/home/kelto/miniforge3/envs/sv_call"
    threads: 8
    params:
        callers = ["pbsv", "sniffles2", "cutesv"],
        min_callers = 2,
        min_overlap = 0.5
    shell:
        """
        python fungus_sv/core/icb.py \
            --bam {input.bam} \
            --reference {input.ref} \
            --output results/variants/{wildcards.sample}/ \
            --callers {params.callers} \
            --min-callers {params.min_callers} \
            --min-overlap {params.min_overlap} \
            --threads {threads}
        """


rule lar_refine:
    """Phase 1 (optional): Refine SV breakpoints via local assembly (LAR)."""
    input:
        consensus = "results/variants/consensus/{sample}.consensus_svs.vcf",
        bam = "results/alignment/{sample}.sorted.bam",
        ref = "data/reference/reference.fasta"
    output:
        refined = "results/variants/refined/{sample}.refined_svs.vcf"
    conda: "/home/kelto/miniforge3/envs/sv_lar"
    threads: 4
    shell:
        """
        python fungus_sv/modules/local_assembly.py \
            --consensus {input.consensus} \
            --bam {input.bam} \
            --reference {input.ref} \
            --output {output.refined} \
            --threads {threads}
        """


rule build_kmer_db:
    """Build jellyfish k-mer database (once per sample)."""
    input:
        fq = "data/raw/{sample}.fastq.gz"
    output:
        jf = "results/kmers/{sample}.jf"
    conda: "/home/kelto/miniforge3/envs/sv_kmers"
    threads: 4
    shell:
        """
        mkdir -p results/kmers/
        jellyfish count -m 31 -s 100M -t {threads} -o {output.jf} {input.fq}
        """


rule validate_triangulation:
    """Phase 2: VALID-SV triangulation across 5 evidence layers."""
    input:
        consensus = "results/variants/consensus/{sample}.consensus_svs.vcf",
        bam = "results/alignment/{sample}.sorted.bam",
        ref = "data/reference/reference.fasta",
        fq = "data/raw/{sample}.fastq.gz",
        jf = "results/kmers/{sample}.jf"
    output:
        summary = "results/validation/{sample}/validation_summary.txt",
        json = "results/validation/{sample}/validation_results.json"
    conda: "/home/kelto/miniforge3/envs/sv_valid"
    threads: 8
    shell:
        """
        python -m valid_sv.run_validation \
            --consensus-vcf {input.consensus} \
            --bam {input.bam} \
            --reference {input.ref} \
            --fastq {input.fq} \
            --jellyfish-db {input.jf} \
            --output results/validation/{wildcards.sample}/ \
            --threads {threads}
        """


rule report:
    """Generate per-SV report cards."""
    input:
        json = "results/validation/{sample}/validation_results.json"
    output:
        report = "results/validation/{sample}/report_cards.tsv"
    conda: "/home/kelto/miniforge3/envs/sv_valid"
    shell:
        """
        python valid_sv/reporting/report_card.py \
            --json {input.json} \
            --output {output.report}
        """

