"""
FUNGUS-SV: Structural variant discovery and triangulation-based
prioritization for non-model haploid fungi using PacBio HiFi reads.

Two-phase architecture:
  Phase 1 (Prediction): ICB consensus from 3 SV callers
  Phase 2 (Validation): VALID-SV triangulation across 5 evidence layers
"""

configfile: "config/config.yaml"

SAMPLES = config["samples"]


rule all:
    """Generate all outputs."""
    input:
        # Phase 1: Prediction
        expand("results/alignment/{sample}.sorted.bam.bai", sample=SAMPLES),
        expand("results/variants/consensus/{sample}.consensus_svs.vcf", sample=SAMPLES),
        expand("results/variants/refined/{sample}.refined_svs.vcf.gz", sample=SAMPLES),
        expand("results/annotation/{sample}.annotated.tsv", sample=SAMPLES),
        # Phase 2: Validation
        expand("results/validation/{sample}/validation_summary.txt", sample=SAMPLES),
        expand("results/validation/{sample}/validation_results.json", sample=SAMPLES),


rule fastqc:
    """Quality control for PacBio HiFi reads."""
    input:
        fq = "data/raw/{sample}.fastq.gz"
    output:
        html = "results/qc/{sample}_fastqc.html"
    threads: 2
    shell:
        "fastqc -t {threads} -o results/qc/ {input.fq}"


rule minimap2_align:
    """Align PacBio HiFi reads to reference genome."""
    input:
        fq = "data/raw/{sample}.fastq.gz",
        ref = "data/reference/reference.mmi"
    output:
        bam = "results/alignment/{sample}.sorted.bam",
        bai = "results/alignment/{sample}.sorted.bam.bai"
    threads: 8
    shell:
        """
        minimap2 -t {threads} -ax map-hifi {input.ref} {input.fq} \
        | samtools sort -@ 4 -o {output.bam} - \
        && samtools index {output.bam}
        """


rule icb_consensus:
    """Phase 1: Multi-caller consensus SV detection (ICB)."""
    input:
        bam = "results/alignment/{sample}.sorted.bam",
        ref = "data/reference/reference.fasta"
    output:
        consensus = "results/variants/consensus/{sample}.consensus_svs.vcf"
    threads: 8
    shell:
        """
        python fungus_sv/core/build_consensus.py \
            --vcfs results/variants/pbsv/{wildcards.sample}.vcf \
                   results/variants/sniffles2/{wildcards.sample}.vcf \
                   results/variants/cutesv/{wildcards.sample}.vcf \
            --caller-names pbsv Sniffles2 cuteSV \
            --output {output.consensus} \
            --reference {input.ref} \
            --min-callers 2 \
            --min-overlap 0.5
        """


rule lar_refine:
    """Refine SV breakpoints via local assembly (LAR)."""
    input:
        consensus = "results/variants/consensus/{sample}.consensus_svs.vcf",
        bam = "results/alignment/{sample}.sorted.bam",
        ref = "data/reference/reference.fasta"
    output:
        refined = "results/variants/refined/{sample}.refined_svs.vcf.gz"
    threads: 4
    shell:
        """
        python fungus_sv/modules/local_assembly.py \
            --consensus {input.consensus} \
            --bam {input.bam} \
            --reference {input.ref} \
            --output {output.refined}
        """


rule validate_triangulation:
    """Phase 2: VALID-SV triangulation across 5 evidence layers."""
    input:
        consensus = "results/variants/consensus/{sample}.consensus_svs.vcf",
        bam = "results/alignment/{sample}.sorted.bam",
        ref = "data/reference/reference.fasta",
        fq = "data/raw/{sample}.fastq.gz"
    output:
        summary = "results/validation/{sample}/validation_summary.txt",
        json = "results/validation/{sample}/validation_results.json"
    threads: 8
    shell:
        """
        python -m valid_sv.run_validation \
            --consensus-vcf {input.consensus} \
            --bam {input.bam} \
            --reference {input.ref} \
            --fastq {input.fq} \
            --output results/validation/{wildcards.sample}/ \
            --min-support 1
        """


rule vep_annotate:
    """Annotate variants with functional predictions."""
    input:
        vcf = "results/variants/refined/{sample}.refined_svs.vcf.gz",
        ref = "data/reference/reference.fasta",
        gff = "data/reference/reference.gff"
    output:
        tsv = "results/annotation/{sample}.annotated.tsv"
    shell:
        """
        python fungus_sv/core/annotate_svs.py \
            --vcf {input.vcf} \
            --gff {input.gff} \
            --output {output.tsv}
        """
